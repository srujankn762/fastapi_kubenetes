// Discover running Docker containers
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Select only the FastAPI container
discovery.relabel "fastapi" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/fastapi-hello-world"
    action        = "keep"
  }

  rule {
    target_label = "job"
    replacement  = "fastapi"
  }
}

// Read FastAPI container logs
loki.source.docker "fastapi" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.fastapi.output
  forward_to = [loki.write.default.receiver]
}

// Forward collected logs to Loki
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}


// Receive OpenTelemetry traces from FastAPI
otelcol.receiver.otlp "default" {
  grpc {
    // Listen on port 4317 on all container interfaces
    endpoint = "0.0.0.0:4317"
  }

  // Forward received traces to the Tempo exporter
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

// Forward traces to Grafana Tempo
otelcol.exporter.otlp "tempo" {
  client {
    // Tempo's internal OTLP/gRPC endpoint
    endpoint = "tempo:4317"

    // Disable TLS for internal local Docker communication
    tls {
      insecure = true
    }
  }
}